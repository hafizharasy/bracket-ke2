# Salin ke .env.local (lokal) atau isi sebagai Variables di Railway.

# Wajib di production: kunci acak panjang untuk sesi login. Buat dengan:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# URL publik aplikasi (HTTPS). Di Railway boleh dikosongkan: otomatis dari
# domain layanan (RAILWAY_PUBLIC_DOMAIN). Isi bila memakai domain sendiri.
BETTER_AUTH_URL=

# Lokasi database & foto bukti. Di Railway (Dockerfile) sudah diatur ke
# volume /app/data, tidak perlu diisi.
# DATABASE_PATH=data/bracket.db
# UPLOAD_DIR=data/uploads

# Demo tanpa database (simulasi turnamen berjalan). Jangan dipakai saat acara.
# BRACKET_DATA_SOURCE=mock
