      "checkConstraints": {
        "matches_status_check": {
          "name": "matches_status_check",
          "value": "\"matches\".\"status\" in ('scheduled', 'ongoing', 'done')"
        },
        "matches_score_check": {
          "name": "matches_score_check",
          "value": "coalesce(\"matches\".\"score_a\", 0) >= 0 and coalesce(\"matches\".\"score_b\", 0) >= 0"
        },
        "matches_winner_check": {
          "name": "matches_winner_check",
          "value": "\"matches\".\"winner_id\" is null or \"matches\".\"winner_id\" in (\"matches\".\"participant_a_id\", \"matches\".\"participant_b_id\")"
        },
        "matches_distinct_check": {
          "name": "matches_distinct_check",
          "value": "\"matches\".\"participant_a_id\" is null or \"matches\".\"participant_b_id\" is null or \"matches\".\"participant_a_id\" <> \"matches\".\"participant_b_id\""
        }
      }
